id:     route:POST /orders
kind:   route (entry)
module: cmd/server
file:   cmd/server/routes.go:13
method: POST

POST /orders
  auth.Handler.RequireUser
    auth.Handler.parseToken
      auth.Handler.sign
    auth.Store.UserByID
      users [table]  reads: SELECT id, email FROM users WHERE id = $1
    auth.withUser
  orders.Handler.Create
    auth.CurrentUser
    orders.Service.Place
      events.Bus.Publish
        server.logConn.Publish
      inventory.Store.Reserve
        stock [table]  writes: UPDATE stock SET reserved = reserved + $2 WHERE sku = $1 AND on_hand - reserved >= $2
      orders.Repo.Insert
        orders [table]  writes: INSERT INTO orders (user_id, items, charge_id, status) VALUES ($1, $2, $3, $4) RETURNING id
      orders.CreateOrder.Total
      payments.Client.Charge
        api.stripe.com [service]  PaymentIntents.New
      order.placed [topic]  publishes
    orders.writeError
    orders.writeJSON

Tests:
  test:go:shop/internal/auth.TestRequireUser_MissingToken  internal/auth/middleware_test.go:11  (direct)
  test:go:shop/internal/inventory.TestReserve_InsufficientStock  internal/inventory/reserve_test.go:11  (direct)
  test:go:shop/internal/orders.TestPlace_ChargesAndInserts  internal/orders/service_test.go:53  (direct)
  test:go:shop/internal/orders.TestPlace_OutOfStock  internal/orders/service_test.go:64  (direct)
